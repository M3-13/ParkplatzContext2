{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "parkplatz",
  "version": "0.1.0",
  "identifier": "dev.parkplatz.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Parkplatz",
        "width": 420,
        "height": 560,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
